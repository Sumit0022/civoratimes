# Twitter API Credentials (OAuth 1.0a User Context)
TWITTER_CONSUMER_KEY="your_consumer_key"
TWITTER_CONSUMER_SECRET="your_consumer_secret"
TWITTER_ACCESS_TOKEN="your_access_token"
TWITTER_ACCESS_TOKEN_SECRET="your_access_token_secret"

# Google Drive API Settings
# Folder IDs can be found in the URL when you open the folder in Drive
# Example: https://drive.google.com/drive/folders/1A2B3C4D5E6F7G8H9I0J?usp=drive_link -> ID is 1A2B3C4D5E6F7G8H9I0J
DRIVE_QUEUE_FOLDER_ID="your_queue_folder_id"
DRIVE_POSTED_FOLDER_ID="your_posted_folder_id"

# Google Service Account JSON (Minified into a single line string)
# Example: {"type": "service_account", "project_id": "..."}
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'
